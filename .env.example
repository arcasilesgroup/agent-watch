# Copy to .env (chmod 600) and fill ONE key — scripts/whisper.py reads this
# file as a key fallback when ~/.config/watch/.env has nothing.
# Never commit a real key; .env is gitignored.

GROQ_API_KEY=
OPENAI_API_KEY=
NAN_API_KEY=

# Optional: read a key from a file instead of pasting it here
# WATCH_NAN_KEY_FILE=

# Optional: custom OpenAI-compatible providers (see PROVIDERS.md)
# WATCH_EXTRA_PROVIDERS=localbox
# WATCH_LOCALBOX_ENDPOINT=http://127.0.0.1:11434/v1/audio/transcriptions
# WATCH_LOCALBOX_MODEL=whisper-large-v3-turbo
# WATCH_LOCALBOX_AUTH=none
